{
  "name": "clawmate-server",
  "version": "1.0.0",
  "description": "ClawMate License Authorization Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "docker:dev": "cp .env.development .env && docker compose up -d --build api",
    "docker:prod": "cp .env.production .env && docker compose up -d --build api",
    "docker:seed": "docker compose exec api npx tsx prisma/seed.ts",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --build && docker compose exec api npx prisma migrate deploy && docker compose exec api npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.8.5",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "tweetnacl": "^1.0.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
