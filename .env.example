# Server
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000
SITE_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://clawmate:password@localhost:5432/clawmate

# Redis
REDIS_URL=redis://localhost:6379

# Ed25519 Keys (使用 `npx tsx scripts/generate-keys.ts` 生成)
ED25519_PRIVATE_KEY=
ED25519_PUBLIC_KEY=

# Alipay (开发环境留空走 mock，生产环境必须配置)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_AES_KEY=
ALIPAY_GATEWAY=

# WeChat Pay (开发环境留空走 mock，生产环境必须配置)
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_API_KEY=
WECHAT_CERT_PATH=
WECHAT_PRIVATE_KEY_PATH=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# License
DEFAULT_TRIAL_DAYS=7
LICENSE_PRICE=98.00
LICENSE_DISCOUNT_PRICE=

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
